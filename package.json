{
  "name": "sophos-loyalty",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @sophos/api dev",
    "demo": "tsx scripts/demo.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --build --force",
    "check:google": "tsx scripts/check-google.ts",
    "patch:balance": "tsx scripts/patch-balance.ts",
    "rename:class": "tsx scripts/rename-class.ts",
    "build": "node build.mjs",
    "start": "node dist/index.js"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@sophos/db": "workspace:*",
    "@sophos/passes": "workspace:*",
    "@sophos/rules": "workspace:*",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.21.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.11.3",
    "jose": "^6.2.8",
    "node-forge": "^1.4.0",
    "pg": "^8.23.0",
    "pngjs": "^7.0.0",
    "zod": "^4.4.3"
  }
}
