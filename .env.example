# Copiar a .env.local y completar. `.env*` está en .gitignore salvo este archivo.

# ---------------------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------------------
# Sin esta variable la API levanta PGlite en memoria: sirve para desarrollo pero
# pierde todo al reiniciar.
# DATABASE_URL=postgres://usuario:clave@host:5432/loyalty

# ---------------------------------------------------------------------------
# Firma de access tokens
# ---------------------------------------------------------------------------
# Obligatoria en producción. Si cambia, todos los productos integrados pierden
# sus tokens de golpe.
# JWT_SIGNING_KEY=

# ---------------------------------------------------------------------------
# Google Wallet
# ---------------------------------------------------------------------------
# Issuer de Sophos Group en la Google Pay & Wallet Console. No es un secreto:
# viaja dentro de cada pase emitido.
GOOGLE_WALLET_ISSUER_ID=3388000000023171859

# Service account de GCP con rol Wallet Object Issuer, invitada además en
# Wallet Console → Users. Sin esa invitación la API responde 403 sin explicar
# por qué.
# GOOGLE_WALLET_SA_EMAIL=loyalty@proyecto.iam.gserviceaccount.com

# Clave privada de la service account, campo `private_key` del JSON de GCP.
# Se acepta con los saltos de línea escapados (\n), que es como vienen.
# GOOGLE_WALLET_SA_PRIVATE_KEY=

# Dominios autorizados a mostrar el botón de guardado.
GOOGLE_WALLET_ORIGINS=https://tarjeta.sophosgroup.com.py

# ---------------------------------------------------------------------------
# Servidor
# ---------------------------------------------------------------------------
# PORT=3001
