{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "verbatimModuleSyntax": true,

    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "noEmit": true
  },
  "include": ["apps/*/src/**/*.ts", "packages/*/src/**/*.ts", "scripts/*.ts", "*.config.ts"],
  // La app de Next tiene su propio tsconfig con los tipos del framework
  // (`next.fetch`, JSX, el plugin). Chequearla desde acá produce errores falsos.
  "exclude": ["node_modules", "apps/join", "apps/console"]
}
